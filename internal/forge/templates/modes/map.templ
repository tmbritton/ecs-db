package modes

import "github.com/tmbritton/ecs-db/internal/forge/templates/components"


templ mapListBody(data Data) {
	<div class="section-heading"><span>Maps ◂ game.toml</span></div>
	<p class="schema__hint mono">one Tiled level each</p>
	for _, m := range data.Maps {
		<a
			href={ URL(data.MapView.WithMap(m.Path).Href()) }
			class={ "list-row", kv("list-row--active", m.Path == data.SelectedMap) }
			data-testid={ "map-" + m.Name }
			data-active={ boolAttr(m.Path == data.SelectedMap) }
			data-dirty={ boolAttr(data.DirtyMaps[m.Path]) }
			data-configured={ boolAttr(m.Configured) }
			if m.Path == data.SelectedMap {
				aria-current="true"
			}
		>
			<span class="list-row__glyph" aria-hidden="true">🗺</span>
			<span class="list-row__label">{ m.Name }</span>
			if data.DirtyMaps[m.Path] {
				<span class="badge-problem" title="unsaved changes" data-testid={ "map-dirty-" + m.Name }>●</span>
			}
			if m.Configured {
				<span
					class="badge-override mono"
					title="the map game.toml names — the one ecs-db run loads"
					data-testid={ "map-configured-" + m.Name }
				>loaded</span>
			}
		</a>
	}
	<p class="schema__hint">
		Only the map marked <span class="mono">loaded</span> is the one
		<span class="mono">ecs-db run</span> reads.
	</p>
	if data.SelectedMap != "" {
		@mapLayers(data)
		@mapPalette(data)
		@spawnPalette(data)
	}
}

// Two states leave the strip empty and they read differently: a project with no
// [map] at all, which is a project without a level, and one whose configured map
// is missing or will not open, which is a broken project with a reason already
// on screen above. Telling the second group to add a section they have is how
// you get someone reading their own game.toml twice.
templ noMaps(data Data) {
	if data.ConfiguredMap == "" {
		<div class="schema__empty" data-testid="no-maps">
			<p>This project declares no map.</p>
			<p class="schema__hint mono">
				Add a <span class="mono">[map]</span> section to game.toml naming a .tmx file.
			</p>
		</div>
	} else {
		<div class="schema__empty" data-testid="map-unavailable">
			<p>game.toml names a map that could not be opened.</p>
			<p class="schema__hint mono">{ data.ConfiguredMap }</p>
		</div>
	}
}


// The source lens is the spine of the mode: it decides what the canvas and the
// inspector are looking at. Only AUTHORED exists — LIVE and REPLAY read a
// running game's database — and each says which epic delivers it rather than
// leaving a hole where the control goes.
templ mapToolbar(data Data) {
	// The shortcut binding is on the window rather than on the canvas: the
	// canvas is not focusable, and reaching for a tool should not require having
	// clicked one first. Guarded by Drawn() so the keys do nothing on a map with
	// no tools on screen to change.
	<div
		class="map-toolbar"
		data-testid="map-toolbar"
		if data.Canvas.Drawn() {
			data-on:keydown__window={ shortcutAction() }
		}
	>
		<div class="segmented" role="group" aria-label="Source" data-testid="source-lens">
			<span class="segmented__on" data-testid="lens-authored" aria-current="true">AUTHORED</span>
			<button
				type="button"
				class="segmented__off"
				disabled
				title="Attaching to a running game is Epic 18"
				data-testid="lens-live"
			>● LIVE</button>
			<button
				type="button"
				class="segmented__off"
				disabled
				title="Scrubbing the transitions log is Epic 19"
				data-testid="lens-replay"
			>REPLAY</button>
		</div>
		if data.Canvas.Drawn() {
			<div class="segmented" role="group" aria-label="Zoom" data-testid="zoom-control">
				for _, n := range Steps() {
					<button
						type="button"
						data-on:click={ "$zoom = " + itoa(n) }
						class="segmented__link"
						data-class={ "{'segmented__on': $zoom === " + itoa(n) + "}" }
						data-attr:data-current={ flag("$zoom === " + itoa(n)) }
						data-attr:aria-current={ flag("$zoom === " + itoa(n)) }
						data-testid={ "zoom-" + itoa(n) }
					>{ itoa(n) }×</button>
				}
			</div>
		}
		if data.Canvas.Drawn() {
			// The tools. Which one is chosen, and how the stamp is turned, are
			// the browser's — the server is told them with the stroke rather
			// than remembering them, for the reason every other view control
			// here is a signal.
			<div class="segmented" role="group" aria-label="Tool" data-testid="tool-control">
				for _, tool := range Tools() {
					<button
						type="button"
						data-on:click={ "$tool = '" + tool.Kind + "'" }
						class="segmented__link"
						data-class={ "{'segmented__on': $tool === '" + tool.Kind + "'}" }
						data-attr:data-current={ flag("$tool === '" + tool.Kind + "'") }
						data-attr:aria-current={ flag("$tool === '" + tool.Kind + "'") }
						data-testid={ "tool-" + tool.Kind }
						title={ tool.Title }
					>{ tool.Glyph }</button>
				}
			</div>
			<div class="segmented" role="group" aria-label="Stamp orientation" data-testid="turn-control">
				<button
					type="button"
					data-on:click={ turnAction() }
					class="segmented__link"
					data-testid="turn-cw"
					title="rotate the stamp a quarter turn clockwise"
				>⟳</button>
				// The mirrors are actions, not toggles, and deliberately have no
				// on-state. $flipH is a raw flag rather than "is it mirrored":
				// a quarter turn sets it, so a lit button would report a turned
				// stamp as mirrored. The note beside them says which way the
				// stamp is actually facing.
				<button
					type="button"
					data-on:click="$flipH = !$flipH"
					class="segmented__link"
					data-testid="flip-h"
					title="mirror the stamp left to right"
				>⇋</button>
				<button
					type="button"
					data-on:click="$flipV = !$flipV"
					class="segmented__link"
					data-testid="flip-v"
					title="mirror the stamp top to bottom"
				>⇅</button>
			</div>
			// Seeded, like every other data-text here: an empty element is a
			// blank gap until Datastar hydrates, and the stamp always starts
			// upright anyway.
			<span class="map-toolbar__note mono" data-testid="map-tools-note" data-text={ turnLabelExpr() }>{ turnLabelSeed() }</span>
			// The grid is scaffolding for the eye and is never written to the
			// file, which is why it is a signal beside the zoom rather than
			// anything the server renders.
			<div class="segmented" role="group" aria-label="Grid" data-testid="grid-control">
				<button
					type="button"
					data-on:click={ gridToggle() }
					class="segmented__link"
					data-class="{'segmented__on': $grid}"
					data-attr:data-current={ flag("$grid") }
					data-attr:aria-pressed={ flag("$grid") }
					data-testid="grid-toggle"
					title="show or hide the grid"
					data-attr:title={ gridTitleExpr() }
				>#</button>
			</div>
		}
	</div>
}

// The canvas: one absolutely positioned element per non-empty cell, emitted in
// draw order so the stacking is the engine's without the template knowing what
// stacking is.
templ mapCanvas(data Data) {
	<div class="map-viewport" data-testid="map-viewport">
		// Two boxes, because a transform does not change the box it is on: the
		// outer one takes up the scaled space so the viewport scrolls right,
		// the inner one is scaled and holds the cells at their own size.
		//
		// data-on:paintstroke is static/js/paint.js's other end. The module
		// dispatches one event on release, having done the pointer arithmetic and
		// nothing else; which of the gesture's three descriptions the request
		// carries is decided from the tool signal here — see strokeAction, and
		// the module's own opening comment for why it is not decided there.
		<div
			class="map-canvas"
			data-testid="map-canvas"
			style={ canvasVars(data.Canvas) }
			data-style={ "{'--map-zoom': $zoom}" }
			data-attr:data-cell-w={ "$zoom * " + itoa(data.Canvas.TileW) }
			data-attr:data-cell-h={ "$zoom * " + itoa(data.Canvas.TileH) }
			data-on:contextmenu={ mapCanvasMenuAction(data.SelectedMap) }
			tabindex="0"
			aria-label="Map canvas; right-click a tile to pick it"
			data-on:paintstroke={ strokeAction(data) }
			data-on:spawndrop={ spawnDropAction(data.SelectedMap) }
		>
			// The grid is outside the scaled box on purpose: inside it, an 8×
			// zoom would draw 8px lines. Its own spacing scales by calc so the
			// squares still line up with the tiles.
			<div class="map-canvas__grid" aria-hidden="true" data-class={ gridClass() }></div>
			// The ghost and the marquee. Server-rendered so that what they look
			// like and what they say stay Datastar's; paint.js only writes where
			// they are, as custom properties on the box above.
			//
			// Outside the scaled box, like the grid, so a 2px dashed border is
			// 2px at every zoom rather than sixteen.
			<div class="map-ghost" aria-hidden="true" data-testid="map-ghost">
				<span class="map-ghost__note mono" data-testid="map-ghost-note" data-text={ ghostNoteExpr() }>{ turnLabelSeed() }</span>
			</div>
			<div
				class="map-marquee"
				aria-hidden="true"
				data-testid="map-marquee"
				data-class={ marqueeClass() }
			></div>
			<div class="map-canvas__scaled">
				for _, l := range data.Canvas.Layers {
					<div
						class="map-layer"
						data-testid={ "map-layer-" + itoa(l.Index) }
						data-signals__ifmissing={ hideSeed(l) }
						data-class={ "{'map-layer--hidden': " + hideSignal(l) + "}" }
					>
						for _, c := range cellsOfLayer(data.Canvas, l.Index) {
							if c.Unresolved() {
								<div
									class="map-cell map-cell--unresolved"
									style={ cellStyle(c) }
									data-testid="map-cell-unresolved"
									data-cell={ cellID(c) }
									title={ c.Problem }
								>?</div>
							} else {
								<div
									class="map-cell"
									style={ cellStyle(c) }
									data-testid="map-cell"
									data-cell={ cellID(c) }
								></div>
							}
						}
					</div>
				}
			</div>
			<div class="map-spawns" data-testid="spawn-canvas">
				for _, group := range data.ObjectGroups {
					for _, obj := range group.Objects {
						if obj.Type != "" {
							<a
								href={ URL(data.MapView.WithSpawn(obj.ID).Href()) }
								class="map-spawn"
								style={ spawnStyle(obj, data.Canvas.TileH) }
								data-testid={ "spawn-" + itoa(obj.ID) }
								data-cell={ spawnCellLabel(obj, data.Canvas.TileW, data.Canvas.TileH) }
								aria-label={ obj.Type + " spawn " + itoa(obj.ID) }
								title={ obj.Type + " · object " + itoa(obj.ID) }
								draggable="true"
								data-on:dragstart={ "evt.dataTransfer.setData('text/plain', 'move:" + itoa(obj.ID) + "')" }
								data-on:contextmenu={ mapMenuAction(data.SelectedMap, "spawn", "id", itoa(obj.ID)) }
							>{ obj.Type }</a>
						}
					}
				}
			</div>
		</div>
	</div>
}

// A canvas with a zero scale is a map whose tilesets did not resolve: it was
// never built, so its size, its tile size and its layer count are all zero. A
// row of zeros reads as a map that is 0x0, which is a different and untrue
// thing from a map that could not be drawn — and the reason is already on the
// panel above.
templ mapStatus(data Data) {
	<div class="map-status mono" data-testid="map-status">
		if !data.Canvas.Drawn() {
			<span class="map-status__problem" data-testid="map-not-drawn">not drawn — see above</span>
		} else {
			<span data-testid="map-size">{ itoa(data.Canvas.Cols) }×{ itoa(data.Canvas.Rows) } cells</span>
			<span data-testid="map-tile-size">{ itoa(data.Canvas.TileW) }×{ itoa(data.Canvas.TileH) } px</span>
			<span data-testid="map-zoom" data-text={ zoomLabelExpr(data.Canvas) }>{ zoomLabelSeed(data.Canvas) }</span>
			<span data-testid="map-layer-count">{ layerCount(data.Canvas) }</span>
			<span data-testid="map-active-layer" data-text={ activeLayerExpr(data.Canvas) }>{ activeLayerSeed(data.Canvas) }</span>
			<span data-testid="map-selected-tile" data-text="$tile ? 'tile ' + $tile : 'no tile selected'">no tile selected</span>
			if len(data.Canvas.Problems) > 0 {
				<span class="map-status__problem" data-testid="map-canvas-problem">{ data.Canvas.Problems[0] }</span>
			}
		}
	</div>
}

// The layer panel. Order is file order, which is draw order, which is also the
// order the engine reads a cell's tile from — topmost non-empty wins.
templ mapLayers(data Data) {
	<div class="section-heading" data-testid="layer-heading"><span>Layers</span></div>
	for _, l := range data.Canvas.Layers {
		<div
			class="layer-row"
			data-class={ layerRowClasses(l) }
			data-testid={ "layer-" + l.Name }
			data-attr:data-hidden={ flag(hideSignal(l)) }
			data-attr:data-active={ flag(selectedLayerExpr(l)) }
			data-on:contextmenu={ mapMenuAction(data.SelectedMap, "layer", "layer", itoa(l.Index)) }
		>
			<button
				type="button"
				data-on:click={ "$" + hideSignalName(l) + " = !$" + hideSignalName(l) }
				class="layer-row__eye"
				data-testid={ "layer-eye-" + l.Name }
				title={ layerTitleSeed(l) }
				data-attr:title={ layerTitleExpr(l) }
				aria-label={ "show or hide " + l.Name }
				data-attr:aria-pressed={ flag("!" + hideSignal(l)) }
				data-text={ "$" + hideSignalName(l) + " ? '—' : '👁'" }
			>{ eyeSeed(l) }</button>
			<button
				type="button"
				data-on:click={ selectLayerAction(l) }
				class="layer-row__name"
				data-testid={ "layer-select-" + l.Name }
				title="paint into this layer"
				data-attr:aria-current={ flag(selectedLayerExpr(l)) }
			>{ l.Name }</button>
			if l.HiddenInFile {
				<span class="badge-override mono" data-testid={ "layer-file-hidden-" + l.Name }>file</span>
			}
			if l.Transparent {
				<span class="badge-override mono" title="the map sets this layer's opacity to 0" data-testid={ "layer-transparent-" + l.Name }>α0</span>
			}
			if l.Empty {
				<span class="badge-problem mono" data-testid={ "layer-empty-" + l.Name }>empty</span>
			}
		</div>
	}
	<p class="schema__hint" data-testid="layer-note">
		The eye is what Forge draws. It is not written to the file, and the engine
		imports a hidden layer's tiles either way. The highlighted layer is the one
		a stroke lands on.
	</p>
}

// One fixed-position menu, outside the scroll container and inside the small
// head region. Opening it does not re-send hundreds of canvas cells.
templ mapContextMenu(data Data) {
	if data.MapMenu.Open {
		<div
			class="ctx-menu__at"
			style={ mapMenuStyle(data.MapMenu) }
			data-testid="map-context-menu"
			data-on:keydown__window={ "evt.key === 'Escape' && " + mapCloseAction(data.MapMenu) }
			data-on:click__window={ "!el.contains(evt.target) && " + mapCloseAction(data.MapMenu) }
		>
			@components.ContextMenu(components.ContextMenuProps{
				Title: mapMenuTitle(data.MapMenu),
				Items: mapMenuItems(data.MapMenu),
				Autofocus: true,
			})
		</div>
	}
}

// The palette, by tileset. A collection tileset shows its tiles' own pictures,
// which is what Epic 14 Story 2 supports and what half of real projects use.
templ mapPalette(data Data) {
	<div class="section-heading" data-testid="palette-heading"><span>Tilesets ◂ the map</span></div>
	for _, set := range data.Canvas.Tilesets {
		<div class="palette" data-testid={ "palette-" + set.Name }>
			<div class="palette__name mono">{ set.Name }</div>
			if set.Problem != "" {
				<p class="palette__problem" role="alert" data-testid={ "palette-problem-" + set.Name }>{ set.Problem }</p>
			}
			<div class="palette__tiles">
				for _, t := range set.Tiles {
					// A button, not a link: it goes nowhere. Clicking the tile
					// already in hand puts it down again, which is how you paint
					// nothing without reaching for the eraser.
					<button
						type="button"
						data-on:click={ toggleSignal("$tile", t.GID) }
						data-class={ selectedWhen("$tile", t.GID, "palette-tile--selected") }
						data-attr:data-selected={ flag(eq("$tile", t.GID)) }
						data-attr:aria-pressed={ flag(eq("$tile", t.GID)) }
						class="palette-tile"
						style={ paletteStyle(t) }
						data-testid={ "palette-tile-" + gidLabel(t.GID) }
						title={ "global id " + gidLabel(t.GID) }
						aria-label={ "tile " + gidLabel(t.GID) }
					></button>
				}
			</div>
		</div>
	}
}

templ spawnPalette(data Data) {
	<div class="section-heading" data-testid="spawn-palette-heading">Entity types ◂ schema.json</div>
	if len(data.ObjectGroups) == 0 {
		<p class="schema__hint">This map has no object group for spawns.</p>
	} else {
		<div class="segmented" role="group" aria-label="Object group">
			for i, group := range data.ObjectGroups {
				<button
					type="button"
					class="segmented__link"
					data-on:click={ "$group = " + itoa(i) }
					data-class={ "{'segmented__on': $group === " + itoa(i) + "}" }
					data-attr:data-current={ flag(eq("$group", uint32(i))) }
					data-attr:aria-pressed={ flag(eq("$group", uint32(i))) }
					data-testid={ "object-group-" + group.Name }
				>{ group.Name }</button>
			}
		</div>
	}
	for _, name := range entityTypeNames(data.Schema) {
		if name == "Tile" {
			// Tile objects belong to the map importer, not the spawn palette.
		} else if spawnReason(data.Schema, name) == "" && len(data.ObjectGroups) > 0 {
			<div
				class="spawn-palette__type"
				data-testid={ "spawn-type-" + name }
				aria-label={ "drag " + name + " spawn to the map" }
				draggable="true"
					data-on:dragstart={ spawnDragType(name) }
			>{ name }</div>
		} else {
			<div class="spawn-palette__type spawn-palette__type--disabled" data-testid={ "spawn-type-" + name }>
				{ name } · { spawnReason(data.Schema, name) }
			</div>
		}
	}
}

templ spawnInspector(data Data) {
	if data.SelectedSpawn != nil {
		{{ et := data.Schema.EntityTypes[data.SelectedSpawn.Type] }}
		<div class="map-spawn-inspector" data-testid="spawn-selected">
			<span class="mono">{ data.SelectedSpawn.Type } · object { itoa(data.SelectedSpawn.ID) }</span>
			<button
				type="button"
				data-testid="spawn-delete"
				aria-label={ "delete " + data.SelectedSpawn.Type + " spawn" }
				data-on:click={ spawnDeleteAction(data.SelectedMap, data.SelectedSpawn.ID) }
			>Delete</button>
			<p>Deleting this spawn removes its entity on the next ecs-db run.</p>
			<div class="spawn-inspector__behavior" data-testid="spawn-behavior">
				Behaviour from schema.json · entityTypes.{ data.SelectedSpawn.Type }:
				if et.Behavior == "" {
					<span class="mono">none</span>
				} else {
					<span class="mono">{ et.Behavior }</span>
				}
				<a href={ URL(entityTypeHref(data.SelectedSpawn.Type)) }>Change in ENTS</a>
			</div>
			for _, message := range data.SpawnErrors {
				<p class="schema__problem" role="alert">{ message }</p>
			}
			for _, message := range data.SpawnWarnings {
				<p class="schema__note" role="status" data-testid="spawn-contract-warning">Warning: { message }</p>
			}
			for _, message := range spawnContextProblems(data) {
				<p class="schema__problem" role="alert" data-testid="spawn-context-warning">{ message }</p>
			}
			<div class="spawn-inspector__components" data-testid="spawn-components">
				for _, c := range spawnComponentViews(data) {
					<div class="spawn-inspector__component" data-testid={ "spawn-component-" + c.Name }>
						if c.Required {
							@components.Chip(components.ChipProps{Name: c.Name, Kind: components.ChipRequired, ContextSeeded: c.Seeded})
						} else {
							@components.Chip(components.ChipProps{Name: c.Name, Kind: components.ChipOptional, ContextSeeded: c.Seeded, RemoveAction: spawnDetachAction(data, c.Name)})
						}
						if c.Name == "Position" {
							<span class="mono" data-testid="spawn-position">{ c.Position }</span>
							<p>Position comes from where the object sits. Move the object to change it.</p>
						} else if !c.Present {
							<p class="schema__problem">Missing required component in this map object.</p>
						} else {
							for _, field := range c.Fields {
								<div class="spawn-inspector__field">
									if field.Sheet {
										<span class="mono">Sprite.sheet · { field.Value }</span>
										<p>animations.toml overrides Sprite.sheet at start-up.</p>
									} else {
										<label class="schema__row">
											<span class="schema__label">{ c.Name }.{ field.Name }</span>
											<input
												type="text"
												class="schema__input mono"
												value={ field.Value }
												aria-label={ c.Name + "." + field.Name }
												data-testid={ "spawn-field-" + c.Name + "." + field.Name }
												data-on:change={ spawnFieldAction(data, c.Name, field.Name) }
											/>
										</label>
										if field.ContextSeeded {
											<span class="badge-ctx" data-testid={ "spawn-ctx-" + c.Name + "." + field.Name } title="the bound machine seeds missing components only; this component is already present, so the map value wins at startup">ƒ ctx</span>
										}
									}
								</div>
							}
						}
					</div>
				}
			</div>
			if len(spawnMissingRequired(data)) > 0 {
				<button type="button" class="btn--dashed" data-testid="spawn-repair-required" data-on:click={ spawnRepairAction(data) }>
					Repair required components
				</button>
			}
			if len(spawnAddable(data)) > 0 {
				<div class="section-heading">+ ADD COMPONENT</div>
				if len(spawnAddableRegular(data)) > 0 {
					<label class="schema__row">
						<span class="schema__label">Component</span>
						<select data-testid="spawn-add-component" data-on:change={ spawnAddAction(data) }>
							<option value="">choose…</option>
							for _, name := range spawnAddableRegular(data) {
								<option value={ name }>{ name }</option>
							}
						</select>
					</label>
				}
				for _, name := range spawnAddableReferences(data) {
					<div class="schema__row">
						<span class="schema__label">{ name } target entity id</span>
						for _, field := range spawnReferenceFields(data.Schema.Components[name]) {
							<label class="schema__row">
								<span class="schema__label">{ field }</span>
								<input type="number" min="1" class="schema__input mono" data-ref-field={ field } data-testid={ spawnReferenceTestID(name, data.Schema.Components[name], field) } aria-label={ name + "." + field + " target entity id" }/>
							</label>
						}
						<button type="button" data-testid={ "spawn-attach-" + name } data-on:click={ spawnReferenceAction(data, name) }>Attach { name }</button>
					</div>
				<p class="schema__note">A target must name an entity that exists when the engine imports this map.</p>
			}
			}
			@contextSeedsPanel(data, et)
		</div>
	} else if data.MissingSpawn > 0 {
		<div class="map-spawn-inspector" data-testid="spawn-missing">
			Object { itoa(data.MissingSpawn) } is no longer in this map.
			<a href={ URL(data.MapView.WithSpawn(0).Href()) } data-testid="spawn-clear-selection">Clear selection</a>
		</div>
	}
}

templ mapProblems(data Data) {
	if len(data.MapProblems) > 0 {
		<div class="problems-block" data-testid="map-project-problems">
			<div class="section-heading">Maps that did not load</div>
			<ul class="problems" role="alert">
				for _, p := range data.MapProblems {
					<li class="problem problem--warning">
						<span class="problem__badge mono">{ fileName(p.Path) }</span>
						<span class="problem__text">{ p.Err.Error() }</span>
					</li>
				}
			</ul>
		</div>
	}
}
