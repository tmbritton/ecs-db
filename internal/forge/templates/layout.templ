package templates

// Layout is the base document every Forge page is served inside. Datastar is
// loaded as a module and self-initialises; there is no bootstrap call and no
// frontend build step.
templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			// Classic and first, not a module like the rest. A module is
			// deferred to end-of-parse, and `pagereveal` fires at the new
			// document's first rendering opportunity — so on a slow parse the
			// listener would be registered after the event it exists to catch,
			// which is the likeliest explanation for the one uncaught
			// AbortError the browser suite ever saw. See the file itself.
			<script src="/static/js/viewtransition.js"></script>
			<link rel="stylesheet" href="/static/css/fonts.css"/>
			<link rel="stylesheet" href="/static/css/tokens.css"/>
			<link rel="stylesheet" href="/static/css/forge.css"/>
			<script type="module" src="/static/js/vendor/datastar.js"></script>
			// The statechart canvas's pointer handling. A module, loaded once,
			// binding once from the document — the mode content is replaced by
			// the page stream, so anything bound to it would die with it.
			<script type="module" src="/static/js/canvas.js"></script>
			// The map canvas's pointer handling, on the same terms: a module,
			// loaded once, binding once from the document. Two hand-written
			// pointer surfaces is the budget for the whole tool.
			<script type="module" src="/static/js/paint.js"></script>
			<script type="module" src="/static/js/spritepreview.js"></script>
			// The browser honours autofocus only on content the parser
			// inserted, and everything the page stream delivers is built with
			// DOM APIs instead. This makes the attribute mean what it says
			// wherever it appears.
			<script type="module" src="/static/js/autofocus.js"></script>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}
