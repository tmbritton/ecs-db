{
  "id": "sentry",
  "initial": "idle",
  "description": "watches a corridor and shouts",
  "tags": ["enemy", "stationary"],
  "context": {
    "aggroRange": 80
  },
  "states": {
    "idle": {
      "description": "standing still",
      "tags": ["passive"],
      "meta": {
        "layout": { "x": 100, "y": 200 },
        "notes": "the resting state"
      },
      "on": {
        "SPOTTED": { "target": "alerting" },
        "RESET": "idle"
      }
    },
    "alerting": {
      "meta": { "layout": { "x": 320, "y": 200 } },
      "entry": { "type": "log", "params": { "message": "!" } },
      "exit": "log",
      "on": {
        "CALM": [{ "target": "idle", "cond": "timerExpired" }]
      }
    }
  }
}
