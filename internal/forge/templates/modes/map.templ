package modes

// MapMode is the map editor.
//
// The left rail is what the project holds: its maps, the layers of the one on
// screen, and the tiles its tilesets offer. The main column draws that map.
//
// Everything here is server-rendered and patched down the page stream, and every
// selection — which map, which layers are drawn, which layer a stroke lands on,
// which tile is in hand — is in the URL. So it survives a reload, it can be
// linked, and the routes that paint read it from the request rather than from
// state the server has to keep per browser.
//
// The inspector rail the prototype puts on the right arrives with Story 7.
templ MapMode(data Data) {
	if !data.HasMaps {
		@stub("MAP", "No project is open — see the log for why.", "")
	} else {
		<div class="schema" data-testid="map-mode">
			@mapList(data)
			<div class="schema__main">
				if data.Problem != "" {
					<p class="schema__problem" role="alert" data-testid="edit-problem">{ data.Problem }</p>
				}
				@mapProblems(data)
				if len(data.Maps) == 0 {
					@noMaps(data)
				} else {
					@mapEditor(data)
				}
			</div>
		</div>
	}
}

templ mapList(data Data) {
	<nav class="schema__list" aria-label="Maps" data-testid="map-list">
		<div class="section-heading"><span>Maps ◂ game.toml</span></div>
		<p class="schema__hint mono">one Tiled level each</p>
		for _, m := range data.Maps {
			<a
				href={ URL(data.MapView.WithMap(m.Path).Href()) }
				class={ "list-row", kv("list-row--active", m.Path == data.SelectedMap) }
				data-testid={ "map-" + m.Name }
				data-active={ boolAttr(m.Path == data.SelectedMap) }
				data-dirty={ boolAttr(data.DirtyMaps[m.Path]) }
				data-configured={ boolAttr(m.Configured) }
				if m.Path == data.SelectedMap {
					aria-current="true"
				}
			>
				<span class="list-row__glyph" aria-hidden="true">🗺</span>
				<span class="list-row__label">{ m.Name }</span>
				if data.DirtyMaps[m.Path] {
					<span class="badge-problem" title="unsaved changes" data-testid={ "map-dirty-" + m.Name }>●</span>
				}
				if m.Configured {
					<span
						class="badge-override mono"
						title="the map game.toml names — the one ecs-db run loads"
						data-testid={ "map-configured-" + m.Name }
					>loaded</span>
				}
			</a>
		}
		<p class="schema__hint">
			Only the map marked <span class="mono">loaded</span> is the one
			<span class="mono">ecs-db run</span> reads.
		</p>
		if data.SelectedMap != "" {
			@mapLayers(data)
			@mapPalette(data)
		}
	</nav>
}

// Two states leave the strip empty and they read differently: a project with no
// [map] at all, which is a project without a level, and one whose configured map
// is missing or will not open, which is a broken project with a reason already
// on screen above. Telling the second group to add a section they have is how
// you get someone reading their own game.toml twice.
templ noMaps(data Data) {
	if data.ConfiguredMap == "" {
		<div class="schema__empty" data-testid="no-maps">
			<p>This project declares no map.</p>
			<p class="schema__hint mono">
				Add a <span class="mono">[map]</span> section to game.toml naming a .tmx file.
			</p>
		</div>
	} else {
		<div class="schema__empty" data-testid="map-unavailable">
			<p>game.toml names a map that could not be opened.</p>
			<p class="schema__hint mono">{ data.ConfiguredMap }</p>
		</div>
	}
}

templ mapEditor(data Data) {
	<div class="map-editor" data-testid="map-editor">
		<header class="schema__editor-head">
			<h2 class="schema__title" data-testid="map-title">{ fileName(data.SelectedMap) }</h2>
			<p class="schema__path mono" data-testid="map-path">{ data.SelectedMap }</p>
		</header>
		@mapToolbar(data)
		@mapCanvas(data)
		@mapStatus(data)
		<p class="schema__foot">
			A saved map takes effect on the next <span class="mono">ecs-db run</span>.
			The engine watches behaviour files and sprite assets; it does not watch maps.
		</p>
	</div>
}

// The source lens is the spine of the mode: it decides what the canvas and the
// inspector are looking at. Only AUTHORED exists — LIVE and REPLAY read a
// running game's database — and each says which epic delivers it rather than
// leaving a hole where the control goes.
templ mapToolbar(data Data) {
	<div class="map-toolbar" data-testid="map-toolbar">
		<div class="segmented" role="group" aria-label="Source" data-testid="source-lens">
			<span class="segmented__on" data-testid="lens-authored" aria-current="true">AUTHORED</span>
			<button
				type="button"
				class="segmented__off"
				disabled
				title="Attaching to a running game is Epic 18"
				data-testid="lens-live"
			>● LIVE</button>
			<button
				type="button"
				class="segmented__off"
				disabled
				title="Scrubbing the transitions log is Epic 19"
				data-testid="lens-replay"
			>REPLAY</button>
		</div>
		if len(zoomSteps(data)) > 0 {
			<div class="segmented" role="group" aria-label="Zoom" data-testid="zoom-control">
				for _, z := range zoomSteps(data) {
					if z.Current {
						<span
							class="segmented__on"
							aria-current="true"
							data-testid={ "zoom-" + itoa(z.N) }
							data-current="true"
						>{ itoa(z.N) }×</span>
					} else {
						<a
							href={ URL(z.Href) }
							class="segmented__link"
							data-testid={ "zoom-" + itoa(z.N) }
							data-current="false"
						>{ itoa(z.N) }×</a>
					}
				}
			</div>
		}
		<span class="map-toolbar__note mono" data-testid="map-tools-note">
			painting arrives in Epic 15 Story 4
		</span>
	</div>
}

// The canvas: one absolutely positioned element per non-empty cell, emitted in
// draw order so the stacking is the engine's without the template knowing what
// stacking is.
templ mapCanvas(data Data) {
	<div class="map-viewport" data-testid="map-viewport">
		<div
			class="map-canvas"
			data-testid="map-canvas"
			style={ canvasBoxStyle(data.Canvas.W, data.Canvas.H) }
			data-cell-w={ itoa(data.Canvas.CellW()) }
			data-cell-h={ itoa(data.Canvas.CellH()) }
		>
		<div class="map-canvas__grid" style={ gridStyle(data.Canvas) } aria-hidden="true"></div>
		for _, c := range data.Canvas.Cells {
			if c.Unresolved() {
				<div
					class="map-cell map-cell--unresolved"
					style={ cellStyle(c) }
					data-testid="map-cell-unresolved"
					data-cell={ cellID(c) }
					title={ c.Problem }
				>?</div>
			} else {
				<div
					class="map-cell"
					style={ cellStyle(c) }
					data-testid="map-cell"
					data-cell={ cellID(c) }
				></div>
			}
		}
		</div>
	</div>
}

// A canvas with a zero scale is a map whose tilesets did not resolve: it was
// never built, so its size, its tile size and its layer count are all zero. A
// row of zeros reads as a map that is 0x0, which is a different and untrue
// thing from a map that could not be drawn — and the reason is already on the
// panel above.
templ mapStatus(data Data) {
	<div class="map-status mono" data-testid="map-status">
		if data.Canvas.Scale < 1 {
			<span class="map-status__problem" data-testid="map-not-drawn">not drawn — see above</span>
		} else {
			<span data-testid="map-size">{ itoa(data.Canvas.Cols) }×{ itoa(data.Canvas.Rows) } cells</span>
			<span data-testid="map-tile-size">{ itoa(data.Canvas.TileW) }×{ itoa(data.Canvas.TileH) } px</span>
			<span data-testid="map-zoom">{ zoomLabel(data.Canvas) }</span>
			<span data-testid="map-layer-count">{ layerCount(data.Canvas) }</span>
			<span data-testid="map-active-layer">{ activeLayerName(data.Canvas) }</span>
			if data.MapView.SelectedGID != 0 {
				<span data-testid="map-selected-tile">tile { gidLabel(data.MapView.SelectedGID) }</span>
			} else {
				<span data-testid="map-selected-tile">no tile selected</span>
			}
			if len(data.Canvas.Problems) > 0 {
				<span class="map-status__problem" data-testid="map-canvas-problem">{ data.Canvas.Problems[0] }</span>
			}
		}
	</div>
}

// The layer panel. Order is file order, which is draw order, which is also the
// order the engine reads a cell's tile from — topmost non-empty wins.
templ mapLayers(data Data) {
	<div class="section-heading" data-testid="layer-heading"><span>Layers</span></div>
	for _, l := range data.Canvas.Layers {
		<div
			class={ "layer-row", kv("layer-row--active", l.Active), kv("layer-row--muted", l.Hidden) }
			data-testid={ "layer-" + l.Name }
			data-hidden={ boolAttr(l.Hidden) }
			data-active={ boolAttr(l.Active) }
		>
			<a
				href={ URL(data.MapView.WithLayerToggled(l.Index).Href()) }
				class="layer-row__eye"
				data-testid={ "layer-eye-" + l.Name }
				title={ layerTitle(l) }
				aria-label={ "show or hide " + l.Name }
			>
				if l.Hidden {
					—
				} else {
					👁
				}
			</a>
			<a
				href={ URL(data.MapView.WithActiveLayer(l.Index).Href()) }
				class="layer-row__name"
				data-testid={ "layer-select-" + l.Name }
				title="paint into this layer"
				if l.Active {
					aria-current="true"
				}
			>{ l.Name }</a>
			if l.HiddenInFile {
				<span class="badge-override mono" data-testid={ "layer-file-hidden-" + l.Name }>file</span>
			}
			if l.Transparent {
				<span class="badge-override mono" title="the map sets this layer's opacity to 0" data-testid={ "layer-transparent-" + l.Name }>α0</span>
			}
			if l.Empty {
				<span class="badge-problem mono" data-testid={ "layer-empty-" + l.Name }>empty</span>
			}
		</div>
	}
	<p class="schema__hint" data-testid="layer-note">
		The eye is what Forge draws. It is not written to the file, and the engine
		imports a hidden layer's tiles either way. The highlighted layer is the one
		a stroke lands on.
	</p>
}

// The palette, by tileset. A collection tileset shows its tiles' own pictures,
// which is what Epic 14 Story 2 supports and what half of real projects use.
templ mapPalette(data Data) {
	<div class="section-heading" data-testid="palette-heading"><span>Tilesets ◂ the map</span></div>
	for _, set := range data.Canvas.Tilesets {
		<div class="palette" data-testid={ "palette-" + set.Name }>
			<div class="palette__name mono">{ set.Name }</div>
			if set.Problem != "" {
				<p class="palette__problem" role="alert" data-testid={ "palette-problem-" + set.Name }>{ set.Problem }</p>
			}
			<div class="palette__tiles">
				for _, t := range set.Tiles {
					<a
						href={ URL(data.MapView.WithTile(t.GID).Href()) }
						class={ "palette-tile", kv("palette-tile--selected", t.Selected) }
						style={ paletteStyle(t) }
						data-testid={ "palette-tile-" + gidLabel(t.GID) }
						data-selected={ boolAttr(t.Selected) }
						title={ "global id " + gidLabel(t.GID) }
						aria-label={ "tile " + gidLabel(t.GID) }
					></a>
				}
			</div>
		</div>
	}
}

templ mapProblems(data Data) {
	if len(data.MapProblems) > 0 {
		<div class="problems-block" data-testid="map-project-problems">
			<div class="section-heading">Maps that did not load</div>
			<ul class="problems" role="alert">
				for _, p := range data.MapProblems {
					<li class="problem problem--warning">
						<span class="problem__badge mono">{ fileName(p.Path) }</span>
						<span class="problem__text">{ p.Err.Error() }</span>
					</li>
				}
			</ul>
		</div>
	}
}
