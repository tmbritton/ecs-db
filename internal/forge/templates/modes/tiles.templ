package modes

import "net/url"
import "path/filepath"
import "strings"
import "github.com/tmbritton/ecs-db/internal/forge/tilesurface"

templ TilesListRegion(data Data) {
	<nav id="mode-list" class="schema__list" aria-label="External tilesets" data-testid="tileset-list">
		<div class="section-heading"><span>Tilesets ◂ maps</span></div>
		for _, entry := range data.Tilesets {
			<a href={ URL("/forge/tiles?file=" + url.QueryEscape(entry.Path)) }
				class={ "list-row", kv("list-row--active", entry.Path == data.SelectedTileset) }
				data-testid={ tilesetRowTestID(data.Tilesets, entry.Path) }
				data-dirty={ boolAttr(data.DirtyTilesets[entry.Path]) }
				if entry.Path == data.SelectedTileset {
					aria-current="true"
				}
			>
				<span class="list-row__glyph" aria-hidden="true">▦</span>
				<span class="list-row__label">{ filepath.Base(entry.Path) }</span>
				if !entry.Writable {
					<span class="badge-override mono">read-only</span>
				}
				if data.DirtyTilesets[entry.Path] {
					<span class="badge-problem" title="unsaved changes">●</span>
				}
			</a>
		}
		if len(data.Tilesets) == 0 {
			<p class="schema__hint" data-testid="no-tilesets">No external tilesets are referenced by open maps.</p>
		}
		<p class="schema__hint">Embedded tilesets belong to their map and are not external TILES files.</p>
	</nav>
}

templ TilesPage(rendered []string) {
	<div class="schema" data-testid="tiles-mode">
		@templ.Raw(rendered[0])
		<div class="schema__main" data-testid="tileset-panel">
			for _, html := range rendered[1:] {
				@templ.Raw(html)
			}
		</div>
	</div>
}

templ TilesHeadRegion(data Data) {
	<div id="tileset-head">
		if data.SelectedTileset == "" {
			<p class="schema__hint">Select an external tileset to inspect it.</p>
		} else {
			<header class="editor-header"><h2 data-testid="tileset-title">{ filepath.Base(data.SelectedTileset) }</h2></header>
			<p class="mono" data-testid="tileset-path">{ data.SelectedTileset }</p>
			for _, entry := range data.Tilesets {
				if entry.Path == data.SelectedTileset {
					if !entry.Writable {
						if strings.EqualFold(filepath.Ext(entry.Path), ".tsj") {
							<p data-testid="tileset-readonly">Read-only tileset. JSON .tsj files are inspected here but not saved by Forge.</p>
						} else {
							<p data-testid="tileset-readonly">Unavailable for editing. See the file problem below.</p>
						}
					}
					if entry.Problem != "" {
						<p class="badge-problem" data-testid="tileset-problem">{ entry.Problem }</p>
					}
					<p>Referenced by:</p>
					<ul data-testid="tileset-maps">
						for _, m := range entry.Maps {
							<li>{ filepath.Base(m) }</li>
						}
					</ul>
				}
			}
			if data.TilesetProblem != "" {
				<p data-testid="tileset-open-problem">{ data.TilesetProblem }</p>
			}
			if data.Tileset != nil {
				<p data-testid="tileset-summary">{ data.Tileset.Name } · { itoa(data.Tileset.TileCount) } tiles</p>
				if data.TileValidation.Errors > 0 || data.TileValidation.Warnings > 0 {
					<div data-testid="tileset-validation" role="status" class="badge-problem">
						{ itoa(data.TileValidation.Errors) } errors · { itoa(data.TileValidation.Warnings) } warnings on the shown page
						for _, finding := range data.TileValidation.Tileset {
							<p>{ finding.Message }</p>
						}
					</div>
				}
				if len(data.TiledOnly) > 0 {
					<div data-testid="tiled-only-metadata" class="schema__hint">
						Tiled metadata is preserved on Save but not simulated:
						for _, name := range data.TiledOnly {
							<span>{ name } · </span>
						}
						Use MAP entities for movement/sight and SPRT for sprite animation.
					</div>
				}
				<p class="schema__hint">Movement and sight come from referenced entities in MAP; artwork metadata alone does not set them.</p>
				<p class="schema__hint" data-testid="tiled-feature-boundary">Tiled collision polygons, tile animations, wangsets and terrains are not game mechanics here. Use MAP occupants for interactions and SPRT for sprite animation; lossless TSX Save preserves the authored XML.</p>
				<div class="tileset-readout mono" data-testid="tileset-metadata">
					<span>class/type: { data.Tileset.Class }</span>
					<span>tile: { itoa(data.Tileset.TileWidth) }×{ itoa(data.Tileset.TileHeight) } px</span>
					<span>columns: { itoa(data.Tileset.Columns) }</span>
					<span>margin: { itoa(data.Tileset.Margin) } · spacing: { itoa(data.Tileset.Spacing) }</span>
					<span>offset: { itoa(data.Tileset.TileOffsetX) },{ itoa(data.Tileset.TileOffsetY) }</span>
					if data.Tileset.Image.Source != "" {
						<span>sheet: { data.Tileset.Image.Source }</span>
					}
				</div>
				if len(data.TileView.Properties) > 0 {
					<div class="tileset-readout mono" data-testid="tileset-properties">
						for _, prop := range data.TileView.Properties {
							<span>{ prop.Name } ({ tilesetPropertyType(prop) }): { prop.Value }</span>
						}
					</div>
				}
			}
			<p class="schema__hint">Saved TSX metadata takes effect on the next ecs-db run.</p>
		}
	</div>
}

templ TilesGridRegion(data Data) {
	<div id="tileset-grid-region">
		if data.Tileset != nil {
			@tilesetGrid(data)
		}
	</div>
}

templ TilesInspectorRegion(data Data) {
	<div id="tileset-inspector-region">
		if data.Tileset != nil {
			@tilesetInspector(data)
		}
		if data.Problem != "" {
			<p class="badge-problem" data-testid="tileset-edit-problem">{ data.Problem }</p>
		}
	</div>
}

templ tilesetGrid(data Data) {
	<section class="tileset-grid-panel" aria-label="Tiles in the selected tileset" data-testid="tile-grid">
		if data.TileView.PageProblem != "" {
			<p class="badge-problem" data-testid="tile-page-problem">{ data.TileView.PageProblem }</p>
		} else if data.TileView.TileCount == 0 {
			<p class="schema__hint" data-testid="tileset-empty">This tileset declares no tiles.</p>
		} else {
			<div class="tileset-grid" role="list" aria-label="Local tile IDs">
				for _, tile := range data.TileView.Tiles {
					<div role="listitem">
					<a
						href={ URL(tilesetTileHref(data.SelectedTileset, tile.ID, data.TileView.Page)) }
						class={ "tileset-tile", kv("tileset-tile--selected", data.TileView.Selected != nil && data.TileView.Selected.ID == tile.ID), kv("tileset-tile--invalid", len(data.TileValidation.Tiles[tile.ID]) > 0) }
						data-testid={ "tile-" + gidLabel(tile.ID) }
						if data.TileView.Selected != nil && data.TileView.Selected.ID == tile.ID {
							aria-current="true"
						}
					>
						@tilesetArt(tile, 48, "tile-grid-art-")
						<span class="mono">{ gidLabel(tile.ID) }</span>
						if tile.Class != "" {
							<span class="mono" data-testid={ "tile-grid-class-" + gidLabel(tile.ID) }>{ tile.Class }</span>
						}
						if len(data.TileValidation.Tiles[tile.ID]) > 0 {
							<span class="badge-problem" data-testid={ "tile-grid-invalid-" + gidLabel(tile.ID) } title="tile metadata needs attention">!</span>
						}
					</a>
					</div>
				}
			</div>
			if data.TileView.Pages > 1 {
				<nav class="tileset-pages" aria-label="Tileset pages">
					if data.TileView.Page > 0 {
						<a href={ URL(tilesetPageHref(data.SelectedTileset, data.TileView.Page - 1)) } data-testid="tile-page-previous">Previous tiles</a>
					}
					<span class="mono">page { itoa(data.TileView.Page + 1) } of { itoa(data.TileView.Pages) }</span>
					if data.TileView.Page + 1 < data.TileView.Pages {
						<a href={ URL(tilesetPageHref(data.SelectedTileset, data.TileView.Page + 1)) } data-testid="tile-page-next">Next tiles</a>
					}
				</nav>
			}
		}
	</section>
}

templ tilesetArt(tile tilesurface.Tile, maxPixels int, idPrefix string) {
	if tile.MissingArt {
		<span class="tileset-art-missing" role="img" aria-label={ "Tile " + gidLabel(tile.ID) + " art unavailable" } data-testid={ idPrefix + gidLabel(tile.ID) }>art unavailable</span>
	} else {
		<span class="tileset-art" role="img" aria-label={ "Tile " + gidLabel(tile.ID) + " image" } style={ tileArtStyle(tile, maxPixels) } data-testid={ idPrefix + gidLabel(tile.ID) }></span>
	}
}

templ tilesetInspector(data Data) {
	<section class="tileset-inspector" aria-label="Selected tile" data-testid="tile-inspector">
		if data.TileView.Problem != "" {
			<p class="badge-problem" data-testid="tile-problem">{ data.TileView.Problem }</p>
		} else if data.TileView.Selected != nil {
			{{ tile := *data.TileView.Selected }}
				<div data-testid="tile-selected">
				<h3>Tile { gidLabel(tile.ID) }</h3>
				if len(data.TileValidation.Tiles[tile.ID]) > 0 {
					<ul data-testid={ "tile-validation-" + gidLabel(tile.ID) } class="badge-problem" role="alert">
						for _, finding := range data.TileValidation.Tiles[tile.ID] {
							<li>{ finding.Message }</li>
						}
					</ul>
				}
				<div class="tileset-inspector__art">@tilesetArt(tile, 192, "tile-inspector-art-")</div>
				<p class="mono" data-testid="tile-class">
					if tile.Class == "" {
						No class/type authored
					} else {
						class/type: { tile.Class }
					}
				</p>
				if tilesetWritable(data) {
					<div class="tileset-edit-fields">
						<label for="tile-class-input">Tile class/type</label>
						<input
							id="tile-class-input"
							class="schema__input"
							type="text"
							value={ tile.Class }
							data-testid="tile-class-input"
							data-on:change={ tilesetTileClassAction(data.SelectedTileset, tile.ID) }
						/>
						if data.ProblemField == "tile-class" {
							<p class="badge-problem" role="alert" data-testid="tile-class-problem">{ data.Problem }</p>
						}
					</div>
				}
				if !tile.Explicit {
					<p class="schema__hint">Implicit sheet tile; no tile-level metadata authored.</p>
				}
				if len(tile.Properties) > 0 {
					<dl class="tileset-properties mono" data-testid="tile-properties">
						for _, prop := range tile.Properties {
							<dt>{ prop.Name } ({ tilesetPropertyType(prop) })</dt><dd>{ prop.Value }</dd>
						}
					</dl>
				} else {
					<p class="schema__hint" data-testid="tile-no-properties">No tile-level properties authored.</p>
				}
				if tilesetWritable(data) {
					<div class="tileset-edit-fields" data-testid="tile-property-editor">
						<label for="tile-property-name">Property name</label>
						<input id="tile-property-name" type="text" class="schema__input" data-testid="tile-property-name" data-bind="tilePropertyName"/>
						<label for="tile-property-type">Property type</label>
						<select id="tile-property-type" class="schema__input" data-testid="tile-property-type" data-bind="tilePropertyType">
							<option value="string" selected>string</option>
							<option value="int">int</option>
							<option value="float">float</option>
							<option value="bool">bool</option>
						</select>
						<label for="tile-property-value">Property value</label>
						<input id="tile-property-value" type="text" class="schema__input" data-testid="tile-property-value" data-bind="tilePropertyValue"/>
						<button type="button" data-testid="tile-property-submit" data-on:click={ tilesetTilePropertyAction(data.SelectedTileset, tile.ID) }>Set property</button>
						if data.ProblemField == "tile-property" {
							<p class="badge-problem" role="alert" data-testid="tile-property-problem">{ data.Problem }</p>
						}
					</div>
				}
			</div>
		}
	</section>
}
