package modes

import "github.com/tmbritton/ecs-db/internal/forge/templates/components"

// stateInspector is what the selected state is, and the controls that change
// it: its name, whether its container enters it, its entry and exit actions,
// and the way to delete it.
//
// The prototype's right rail. It renders only for a selected *state* — an edge
// is Story 7's, and a canvas with nothing selected says so rather than showing
// an empty form.
templ stateInspector(data Data) {
	<aside class="inspector" aria-label="State inspector" data-testid="state-inspector">
		if data.SelectedState == nil {
			<p class="inspector__empty" data-testid="inspector-empty">
				Select a state to edit it. Drag the amber port from one state onto another to
				connect them.
			</p>
		} else {
			<div class="section-heading"><span>State</span></div>

			<label class="inspector__row">
				<span class="inspector__label">name</span>
				<input
					class="inspector__input mono"
					type="text"
					value={ stateName(data) }
					data-testid="state-name"
					data-on:change={ renameStateAction(data) }
				/>
			</label>
			<p class="inspector__note" data-testid="state-rename-note">
				Transitions that target this state follow the rename. One that names a
				different state of the same name does not.
			</p>

			if !isCurrentInitial(data) {
				<button
					type="button"
					class="btn--dashed inspector__initial"
					data-testid="set-initial"
					data-on:click={ setInitialAction(data) }
				>{ initialLabel(data) }</button>
			} else {
				// Absent rather than disabled: an action that does nothing is
				// worse than one that is not there.
				<p class="inspector__note mono" data-testid="already-initial">
					◉ this is where its container starts
				</p>
			}

			@actionList(data, "entry")
			@actionList(data, "exit")

			<button
				type="button"
				class="btn--danger inspector__delete"
				data-testid="delete-state"
				data-on:click={ deleteStateAction(data) }
			>Delete state</button>
		}
	</aside>
}

// actionList is one of the two lists a state carries, in authored order —
// which is the order they run in, so sorting them would be sorting the logic.
templ actionList(data Data, kind string) {
	<div class="inspector__actions" data-testid={ kind + "-actions" }>
		<div class="section-heading"><span>{ kind } actions</span></div>
		for i, spec := range stateActions(data, kind) {
			<div class="action" data-testid={ kind + "-action-" + itoa(i) } data-action={ spec.Type }>
				<div class="action__head">
					<span class="action__name mono">{ spec.Type }</span>
					<button
						type="button"
						class="action__remove"
						data-testid={ "remove-" + kind + "-" + itoa(i) }
						aria-label={ "Remove " + spec.Type }
						data-on:click={ removeActionAction(data, kind, i) }
					>✕</button>
				</div>
				if actionDescription(data, spec.Type) != "" {
					<p class="action__desc" data-testid={ kind + "-desc-" + itoa(i) }>{ actionDescription(data, spec.Type) }</p>
				} else {
					// The registry does not have it, so this machine names an
					// action the engine will refuse. The problem list says so;
					// the inspector does not invent a description for it.
					<p class="action__desc action__desc--unknown" data-testid={ kind + "-unknown-" + itoa(i) }>
						Not an action this project's engine registers.
					</p>
				}
				@actionParamForm(data, kind, i, spec)
			</div>
		}
		<div data-testid={ "add-" + kind + "-action" }>
			@components.Dropdown(components.DropdownProps{
				Label:    "",
				Signal:   "",
				Selected: "",
				Options:  actionOptions(data),
				Action:   addActionAction(data, kind),
			})
		</div>
		if kind == "entry" {
			// Said once per state rather than once per list. The catalogue is
			// closed and looks extensible: a modder cannot add an action
			// without rebuilding the binary, because registration is Go and
			// game.toml's actions list is parsed and read by nothing.
			<p class="inspector__note" data-testid="catalogue-is-closed">
				This list is everything the engine registers. Adding to it means Go and a
				rebuild — <span class="mono">game.toml</span>'s action list is not read yet.
			</p>
		}
	</div>
}

// actionParamForm is generated from the registry's ParamSchema, never written
// out: the registry is where an action's parameters, their types and their
// defaults are declared, and a hand-written form is a second copy that goes
// stale the first time a built-in gains one.
templ actionParamForm(data Data, kind string, index int, spec ActionSpec) {
	{{ params := actionParams(data, spec.Type) }}
	if len(params) == 0 {
		<p class="action__none mono" data-testid={ kind + "-noparams-" + itoa(index) }>no parameters</p>
	} else {
		for _, p := range params {
			{{ fieldID := paramProblemsID(kind, index, p.Name) }}
			{{ problems := paramProblems(spec, p) }}
			<label class="action__param" data-testid={ kind + "-param-" + itoa(index) + "-" + p.Name }>
				<span class="action__param-name mono">
					{ p.Name }
					if p.Required {
						<span class="action__required" title="required">*</span>
					}
				</span>
				if paramIsObject(p) {
					<textarea
						class="action__input mono"
						rows="2"
						data-testid={ "input-" + kind + "-" + itoa(index) + "-" + p.Name }
						if len(problems) > 0 {
							aria-describedby={ fieldID }
							aria-invalid="true"
						}
						data-on:change={ paramAction(data, kind, index, p.Name, false) }
					>{ paramValue(spec, p.Name) }</textarea>
				} else if paramInputType(p) == "checkbox" {
					<input
						class="action__check"
						type="checkbox"
						checked?={ paramIsChecked(spec, p.Name) }
						data-testid={ "input-" + kind + "-" + itoa(index) + "-" + p.Name }
						if len(problems) > 0 {
							aria-describedby={ fieldID }
							aria-invalid="true"
						}
						data-on:change={ paramAction(data, kind, index, p.Name, true) }
					/>
					if paramHint(p) != "" {
						<span class="action__hint mono">{ paramHint(p) }</span>
					}
				} else {
					<input
						class="action__input mono"
						type={ paramInputType(p) }
						if paramInputMode(p) != "" {
							inputmode={ paramInputMode(p) }
						}
						data-param-type={ p.Type }
						value={ paramValue(spec, p.Name) }
						placeholder={ paramPlaceholder(p) }
						data-testid={ "input-" + kind + "-" + itoa(index) + "-" + p.Name }
						if len(problems) > 0 {
							aria-describedby={ fieldID }
							aria-invalid="true"
						}
						data-on:change={ paramAction(data, kind, index, p.Name, false) }
					/>
				}
			</label>
			@components.Problems(components.ProblemsProps{
				ID:       fieldID,
				Problems: problems,
				Testid:   "problem-" + kind + "-" + itoa(index) + "-" + p.Name,
			})
		}
	}
}
