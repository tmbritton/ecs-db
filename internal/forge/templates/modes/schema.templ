package modes

import "github.com/tmbritton/ecs-db/internal/forge/templates/components"


templ componentListBody(data Data, selected string) {
	<div class="section-heading">
		<span>Components</span>
		<button
			type="button"
			class="schema__version"
			title="Bump schemaVersion — a migration marker the engine checks at startup, not a label"
			data-testid="schema-version"
			data-on:click={ action("/forge/schema/version") }
		>v{ itoa(data.Schema.SchemaVersion) }</button>
	</div>
	<p class="schema__hint mono">one comp_* SQL table each</p>
	for _, name := range componentNames(data.Schema) {
		<a
			href={ URL(componentHref(name)) }
			class={ "list-row", kv("list-row--active", name == selected) }
			data-testid={ "component-" + name }
			data-active={ boolAttr(name == selected) }
			data-problem={ boolAttr(hasProblems(data, ownerComponent, name)) }
			if name == selected {
				aria-current="true"
			}
		>
			<span class="list-row__glyph" aria-hidden="true">⛃</span>
			<span class="list-row__label">{ name }</span>
			if data.Schema.Components[name].Behavior != "" {
				<span class="badge-ctx" title="binds a behaviour machine">ƒ</span>
			}
			@problemBadge(data, ownerComponent, name)
		</a>
	}
	<button
		type="button"
		class="btn--dashed schema__add"
		data-testid="add-component"
		data-on:click={ action("/forge/schema/component", "add", "NewComponent") }
	>+ NEW COMPONENT</button>
	<p class="schema__foot">
		Entity types live in the ENTS tab — both halves of
		<span class="mono">schema.json</span>
	</p>
}

templ componentEditor(data Data, name string) {
	{{ comp := data.Schema.Components[name] }}
	{{ owned := unplacedComponentProblems(data, name) }}
	<div class="schema__editor" data-testid="component-editor" data-component={ name }>
		if data.Problem != "" {
			<p class="schema__problem" role="alert" data-testid="edit-problem">{ data.Problem }</p>
		}
		@components.Problems(components.ProblemsProps{Problems: owned, Testid: "component-problems"})
		<div class="schema__title">
			<span class="schema__name" data-testid="component-name">{ name }</span>
			<span class="schema__source mono">schema.json · components.{ name }</span>
		</div>

		<div class="schema__fields">
			<label class="schema__row">
				<span class="schema__label">Name</span>
				<input
					class="schema__input mono"
					type="text"
					value={ name }
					data-testid="component-rename"
					data-on:change={ valueAction("/forge/schema/component", "to", "rename", name) }
				/>
			</label>
			<p class="schema__note">
				<span class="schema__reserved mono">"Behavior"</span> is reserved and cannot name a component.
			</p>

			@components.Dropdown(components.DropdownProps{
				Label:    "Shape",
				Signal:   "",
				Selected: comp.Type,
				Options:  shapeOptions(),
				Action:   valueAction("/forge/schema/shape", "shape", "component", name),
			})

			@components.Dropdown(components.DropdownProps{
				Label:     "Behavior",
				Signal:    "",
				Selected:  comp.Behavior,
				Options:   machineOptions(data.Machines, comp.Behavior),
				Action:    valueAction("/forge/schema/behavior", "behavior", "component", name),
				Problems:  componentProblems(data, name, behaviorField()),
				ProblemID: problemsID("component", name, behaviorField()),
			})
			<p class="schema__note">
				Binding a machine makes attach and detach drive its lifecycle — a final state detaches the component.
			</p>

			if isObject(comp) {
				@fieldsTable(data, comp, name)
			} else {
				<p class="schema__note" data-testid="no-fields">
					A { comp.Type } component has no fields — it becomes a single <span class="mono">value</span> column.
				</p>
			}
		</div>

		@generatedSQLPanel(comp, name)

		@usedByPanel(data, name)

		<button
			type="button"
			class="btn--danger schema__delete"
			data-testid="delete-component"
			data-on:click={ confirmAction("Delete component "+name+"? Its comp_ table and everything in it goes on the next migration.", action("/forge/schema/component", "delete", name)) }
		>Delete component</button>
	</div>
}

templ fieldsTable(data Data, comp Component, component string) {
	<div class="section-heading">Fields → typed SQL columns</div>
	<table class="fields" data-testid="fields-table">
		<thead>
			<tr>
				<th scope="col">Name</th>
				<th scope="col">Type</th>
				<th scope="col">Not null</th>
				<th scope="col"><span class="sr-only">Delete</span></th>
			</tr>
		</thead>
		<tbody>
			for _, field := range propertyNames(comp) {
				{{ fieldID := problemsID("component", component, propertyField(field)) }}
				{{ fieldProblems := componentProblems(data, component, propertyField(field)) }}
				<tr data-testid={ "field-" + field } data-problem={ boolAttr(len(fieldProblems) > 0) }>
					<td>
						<input
							class="schema__input mono"
							type="text"
							value={ field }
							aria-label={ "Name of field " + field }
							if describedBy(fieldID, fieldProblems) != "" {
								aria-describedby={ fieldID }
							}
							if anyBlocking(fieldProblems) {
								aria-invalid="true"
							}
							data-on:change={ valueAction("/forge/schema/field", "to", "component", component, "rename", field) }
						/>
						@components.Problems(components.ProblemsProps{
							ID:       fieldID,
							Problems: fieldProblems,
							Testid:   "field-problems-" + field,
						})
					</td>
					<td>
						@components.Dropdown(components.DropdownProps{
							Label:    "Type of field " + field,
							// No signal, and that is the point. A fields table
							// has one dropdown per row; Datastar's bind plugin
							// seeds a signal from the first bound element and
							// then drives every element bound to that path, so
							// a shared name makes every row display row one's
							// type. valueAction carries the value from the
							// control that changed, so the signal is dead
							// weight as well as wrong.
							Signal:   "",
							Selected: comp.Properties[field].Type,
							Options:  typeOptions(),
							Action:   valueAction("/forge/schema/field", "type", "component", component, "retype", field),
						})
					</td>
					<td class="fields__notnull">
						<span title="Every generated column is NOT NULL — the engine's generator decides, not the editor">always</span>
					</td>
					<td>
						<button
							type="button"
							class="fields__delete"
							title={ "Delete field " + field }
							aria-label={ "Delete field " + field }
							data-testid={ "delete-field-" + field }
							data-on:click={ confirmAction("Delete field "+field+"? Dropping a column is a destructive migration.", action("/forge/schema/field", "component", component, "delete", field)) }
						><span aria-hidden="true">✕</span></button>
					</td>
				</tr>
			}
		</tbody>
	</table>
	<button
		type="button"
		class="btn--dashed"
		data-testid="add-field"
		data-on:click={ action("/forge/schema/field", "component", component, "add", "newField") }
	>+ add field</button>
}

// usedByPanel answers "is this safe to change".
//
// Two kinds of fact, kept apart. Which types declare the component comes from
// the file and is true until someone edits it; how many entities carry it comes
// from a world another process is writing and will be different in a second.
// The live half is cyan, the colour the design reserves for live data, so the
// difference is visible without reading the labels.
templ usedByPanel(data Data, name string) {
	<div class="schema__usedby" data-testid="used-by">
		<div class="section-heading">Used by entity types</div>
		{{ types := usedBy(data.Schema, name) }}
		if len(types) == 0 {
			<p class="schema__note" data-testid="used-by-none">
				Not required or optional on any entity type yet — nothing in the schema refers to it.
			</p>
		} else {
			<div class="schema__chips">
				for _, t := range types {
					<span class="chip" data-testid={ "used-by-" + t }>
						<span class="chip__name">{ t }</span>
					</span>
				}
			</div>
		}
		@componentRows(data, name)
	</div>
}

// componentRows is how many entities actually carry this component.
//
// Its own table, not the population of the types that declare it: a component
// that is optional on a type is carried by some of that type's entities, not
// all of them, so counting the types would overstate it — in the direction that
// makes a destructive migration look worse than it is, and, after a schema
// edit, sometimes better.
templ componentRows(data Data, name string) {
	<div class="live" data-testid="live-counts">
		<div class="section-heading live__heading">Live rows</div>
		if !data.Counts.Available {
			<p class="schema__note" data-testid="live-unavailable">
				{ data.Counts.Reason }. This is not a count of zero.
			</p>
		} else {
			{{ n, built := data.Counts.OfComponent(name) }}
			if !built {
				<p class="schema__note" data-testid="live-not-built">
					No <span class="mono">comp_{ lower(name) }</span> table in the database yet —
					the engine creates it on its next migration. Nothing is stored for this
					component, as opposed to nothing being counted.
				</p>
			} else {
				<p class="live__single" data-testid={ "live-rows-" + name }>
					<span class="live__count mono">{ itoa(n) }</span>
					<span class="live__label">
						if n == 1 {
							entity carries this component right now
						} else {
							entities carry this component right now
						}
					</span>
				</p>
			}
			@staleNote(data)
		}
		@spawnNote()
	</div>
}

// staleNote qualifies a count taken against a database built to a different
// schemaVersion. The rows are real; what they describe is an older world.
templ staleNote(data Data) {
	if data.Counts.Stale {
		<p class="schema__note" role="alert" data-testid="live-stale">
			Counted against a database built to
			<span class="mono">v{ itoa(data.Counts.DBVersion) }</span>, not the
			<span class="mono">v{ itoa(data.Schema.SchemaVersion) }</span> being edited — names and
			shapes may have moved since, so a zero here can mean "filed under a different name".
		</p>
	}
}

// spawnNote says what is not here.
//
// Not a zero and not a dash: a zero is indistinguishable from a real answer,
// and someone deciding whether a deletion is safe would act on it.
templ spawnNote() {
	<p class="schema__note" data-testid="spawn-note">
		Spawn counts are not shown: spawns arrive with map object layers in Epic 14, and
		a count of zero before then would be indistinguishable from a real answer.
	</p>
}

// generatedSQLPanel shows the CREATE TABLE the interpreter runs at startup.
//
// The DDL is engine-owned text, so it is mono and it is not case-mangled — the
// same rule the engine-status readout's source suffix follows.
templ generatedSQLPanel(comp Component, name string) {
	<div class="schema__sql" data-testid="generated-sql">
		<div class="section-heading">Generated SQL</div>
		<p class="schema__hint mono">DDL the interpreter runs at startup</p>
		{{ ddl, err := generatedSQL(comp, name) }}
		if err != nil {
			<p class="schema__problem" data-testid="generated-sql-error">
				This component cannot be generated: { err.Error() }
			</p>
		} else {
			<pre class="schema__ddl mono" data-testid="generated-sql-text">{ ddl }</pre>
		}
		if isArray(comp) {
			<p class="schema__note" data-testid="array-note">
				Arrays are stored as JSON in one <span class="mono">TEXT</span> column — there is no
				junction table.
			</p>
		}
		<p class="schema__note">
			Renaming or removing a field is a migration. The database records the
			<span class="mono">schemaVersion</span> it was built with, and the engine migrates it
			on the next start when that version changes — see the pending migration below.
		</p>
	</div>
}

// fileProblemsPanel is what is wrong with schema.json rather than with anything
// in it — a version below one, or a half of the file with nothing in it.
//
// Rendered in the main column rather than inside the editor because it applies
// whatever is selected, and because the states that produce it are exactly the
// ones where there may be nothing selected at all.
templ fileProblemsPanel(data Data) {
	{{ general := fileProblems(data) }}
	// Partial as well as general, and this is the one place either renders. The
	// note used to sit in both this block and the editor below it, so a page
	// with a file-wide problem *and* a problem on the open component said the
	// same sentence twice and gave two elements one test id — which a Playwright
	// locator reports as a strict-mode violation a long way from its cause.
	if len(general) > 0 || data.Validation.Partial {
		<div class="problems-block" data-testid="file-problems">
			@components.Problems(components.ProblemsProps{Problems: general})
			if data.Validation.Partial {
				@components.PartialNote()
			}
		</div>
	}
}

// problemBadge marks a list row whose owner has something wrong with it.
//
// Two states, because they mean different things to someone looking at a
// disabled Save button: a red ! is one of the reasons it is disabled, an amber
// one is not. The title carries the count, so the badge is not the only way to
// learn there is more than one.
templ problemBadge(data Data, kind OwnerKind, name string) {
	if hasProblems(data, kind, name) {
		<span
			class={ "badge-problem", kv("badge-problem--error", hasBlockingProblems(data, kind, name)) }
			title={ problemSummary(data, kind, name) }
			data-testid={ "row-problem-" + name }
		>!</span>
		<span class="sr-only">{ problemSummary(data, kind, name) }</span>
	}
}
