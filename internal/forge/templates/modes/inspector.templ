package modes

import "github.com/tmbritton/ecs-db/internal/forge/templates/components"

// stateInspector is what the selected state is, and the controls that change
// it: its name, whether its container enters it, its entry and exit actions,
// and the way to delete it.
//
// The prototype's right rail. It renders only for a selected *state* — an edge
// is Story 7's, and a canvas with nothing selected says so rather than showing
// an empty form.
templ stateInspector(data Data) {
	<aside class="inspector" aria-label="State inspector" data-testid="state-inspector">
		if data.SelectedState == nil {
			<p class="inspector__empty" data-testid="inspector-empty">
				Select a state or a transition to edit it. Drag the amber port from one
				state onto another to connect them.
			</p>
		} else {
			<div class="section-heading"><span>State</span></div>

			// What the engine says about this state, first: it is why the node
			// is marked on the canvas, and the reason someone selected it.
			@components.Problems(components.ProblemsProps{
				Problems: stateProblems(data),
				Testid:   "state-problems",
			})

			<label class="inspector__row">
				<span class="inspector__label">name</span>
				<input
					class="inspector__input mono"
					type="text"
					value={ stateName(data) }
					data-testid="state-name"
					data-on:change={ renameStateAction(data) }
				/>
			</label>
			<p class="inspector__note" data-testid="state-rename-note">
				Transitions that target this state follow the rename. One that names a
				different state of the same name does not.
			</p>

			if !isCurrentInitial(data) {
				<button
					type="button"
					class="btn--dashed inspector__initial"
					data-testid="set-initial"
					data-on:click={ setInitialAction(data) }
				>{ initialLabel(data) }</button>
			} else {
				// Absent rather than disabled: an action that does nothing is
				// worse than one that is not there.
				<p class="inspector__note mono" data-testid="already-initial">
					◉ this is where its container starts
				</p>
			}

			@actionList(data, stateActionList(data, "entry"))
			@actionList(data, stateActionList(data, "exit"))

			<button
				type="button"
				class="btn--danger inspector__delete"
				data-testid="delete-state"
				data-on:click={ deleteStateAction(data) }
			>Delete state</button>
		}
	</aside>
}

// actionList is a list of actions and the controls that change it.
//
// Three callers: a state's entry list, a state's exit list, and a transition's.
// All three are []ActionSpec with the same catalogue behind them, so they are
// one list with three owners — and the scope is what keeps their test ids and
// their post URLs apart.
templ actionList(data Data, l ActionList) {
	<div class="inspector__actions" data-testid={ l.Scope + "-actions" }>
		<div class="section-heading"><span>{ l.Title }</span></div>
		for i, spec := range l.Specs {
			<div class="action" data-testid={ l.Scope + "-action-" + itoa(i) } data-action={ spec.Type }>
				<div class="action__head">
					<span class="action__name mono">{ spec.Type }</span>
					<button
						type="button"
						class="action__remove"
						data-testid={ "remove-" + l.Scope + "-" + itoa(i) }
						aria-label={ "Remove " + spec.Type }
						data-on:click={ l.Remove(i) }
					>✕</button>
				</div>
				if actionDescription(data, spec.Type) != "" {
					<p class="action__desc" data-testid={ l.Scope + "-desc-" + itoa(i) }>{ actionDescription(data, spec.Type) }</p>
				} else {
					// The registry does not have it, so this machine names an
					// action the engine will refuse. The problem list says so;
					// the inspector does not invent a description for it.
					<p class="action__desc action__desc--unknown" data-testid={ l.Scope + "-unknown-" + itoa(i) }>
						Not an action this project's engine registers.
					</p>
				}
				@paramForm(l.Form(i, spec))
			</div>
		}
		<div data-testid={ "add-" + l.Scope + "-action" }>
			@components.Dropdown(components.DropdownProps{
				Label:    "",
				Signal:   "",
				Selected: "",
				Options:  actionOptions(data),
				Action:   l.Add,
			})
		</div>
		if l.Note {
			// Said once per panel rather than once per list. The catalogue is
			// closed and looks extensible: a modder cannot add an action
			// without rebuilding the binary, because registration is Go and
			// game.toml's actions list is parsed and read by nothing.
			<p class="inspector__note" data-testid="catalogue-is-closed">
				This list is everything the engine registers. Adding to it means Go and a
				rebuild — <span class="mono">game.toml</span>'s action list is not read yet.
			</p>
		}
	</div>
}

// paramForm is generated from the registry's ParamSchema, never written out:
// the registry is where a parameter's type and default are declared, and a
// hand-written form is a second copy that goes stale the first time a built-in
// gains one.
//
// One form for four callers — a state's entry actions, a state's exit actions, a
// transition's actions and a transition's guard. Actions and guards both carry
// []ParamSchema and this is the same form; two implementations is how the guard
// form grows a feature the action form does not have.
//
// The scope names the form in test ids and in problem ids, so "entry-0" emits
// exactly the input and problem ids Story 6 emitted.
//
// aria-invalid follows components.Blocking and not "is there a message": a
// required parameter left empty is a warning, the file is one the engine
// accepts, and telling a screen reader the field is invalid would be a
// different claim from the one on screen.
templ paramForm(f ParamForm) {
	if len(f.Params) == 0 {
		<p class="action__none mono" data-testid={ "noparams-" + f.Scope }>no parameters</p>
	} else {
		for _, p := range f.Params {
			{{ fieldID := paramProblemsID(f.Scope, p.Name) }}
			{{ problems := paramProblems(f.Values, p, f.What) }}
			<label class="action__param" data-testid={ "param-" + f.Scope + "-" + p.Name }>
				<span class="action__param-name mono">
					{ p.Name }
					if p.Required {
						<span class="action__required" title="required">*</span>
					}
				</span>
				if paramIsObject(p) {
					<textarea
						class="action__input mono"
						rows="2"
						data-param-type={ p.Type }
						data-testid={ "input-" + f.Scope + "-" + p.Name }
						if len(problems) > 0 {
							aria-describedby={ fieldID }
						}
						if components.Blocking(problems) {
							aria-invalid="true"
						}
						data-on:change={ f.Post(p.Name, false) }
					>{ paramValue(f.Values, p.Name) }</textarea>
				} else if paramInputType(p) == "checkbox" {
					<input
						class="action__check"
						type="checkbox"
						checked?={ paramIsChecked(f.Values, p.Name) }
						data-param-type={ p.Type }
						data-testid={ "input-" + f.Scope + "-" + p.Name }
						if len(problems) > 0 {
							aria-describedby={ fieldID }
						}
						if components.Blocking(problems) {
							aria-invalid="true"
						}
						data-on:change={ f.Post(p.Name, true) }
					/>
					if paramHint(p) != "" {
						<span class="action__hint mono">{ paramHint(p) }</span>
					}
				} else {
					<input
						class="action__input mono"
						type={ paramInputType(p) }
						if paramInputMode(p) != "" {
							inputmode={ paramInputMode(p) }
						}
						data-param-type={ p.Type }
						value={ paramValue(f.Values, p.Name) }
						placeholder={ paramPlaceholder(p) }
						data-testid={ "input-" + f.Scope + "-" + p.Name }
						if len(problems) > 0 {
							aria-describedby={ fieldID }
						}
						if components.Blocking(problems) {
							aria-invalid="true"
						}
						data-on:change={ f.Post(p.Name, false) }
					/>
				}
			</label>
			@components.Problems(components.ProblemsProps{
				ID:       fieldID,
				Problems: problems,
				Testid:   "problem-" + f.Scope + "-" + p.Name,
			})
		}
	}
}
