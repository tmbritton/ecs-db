{
  "schemaVersion": 7,
  "components": {
    "Position": {
      "type": "object",
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "Health": {
      "type": "object",
      "properties": {
        "hp":    { "type": "integer" },
        "maxHp": { "type": "integer" }
      }
    },
    "Sprite": {
      "type": "object",
      "properties": {
        "sheet":     { "type": "string" },
        "animation": { "type": "string" },
        "flip_x":    { "type": "boolean" }
      }
    },
    "Tile": {
      "type": "object",
      "properties": {
        "x":         { "type": "integer" },
        "y":         { "type": "integer" },
        "tile_type": { "type": "string" }
      }
    },
    "TileLayer": {
      "type": "object",
      "properties": {
        "map_id":      { "type": "string" },
        "layer_id":    { "type": "integer" },
        "layer_order": { "type": "integer" },
        "draw_order":  { "type": "integer" },
        "cell_w":      { "type": "integer" },
        "cell_h":      { "type": "integer" },
        "visible":     { "type": "boolean" },
        "opacity":     { "type": "number" }
      }
    },
    "TileVisual": {
      "type": "object",
      "properties": {
        "image":    { "type": "string" },
        "source_x": { "type": "integer" },
        "source_y": { "type": "integer" },
        "source_w": { "type": "integer" },
        "source_h": { "type": "integer" },
        "dest_x":   { "type": "integer" },
        "dest_y":   { "type": "integer" },
        "flip_h":   { "type": "boolean" },
        "flip_v":   { "type": "boolean" },
        "flip_d":   { "type": "boolean" },
        "alpha":    { "type": "number" },
        "visible":  { "type": "boolean" }
      }
    },
    "TileEntityOwner": {
      "type": "entity-ref"
    },
    "Passability": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" }
      }
    },
    "Visibility": {
      "type": "object",
      "properties": {
        "kind": { "type": "string" }
      }
    },
    "OccupiedCells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": { "type": "integer" },
          "y": { "type": "integer" }
        }
      }
    },
    "TileReferences": {
      "type": "array",
      "items": { "type": "entity-ref" }
    },
    "Walking": {
      "type": "boolean"
    },
    "Swimming": {
      "type": "boolean"
    },
    "Flying": {
      "type": "boolean"
    },
    "Phased": {
      "type": "boolean"
    },
    "NightVision": {
      "type": "boolean"
    },
    "Path": {
      "type": "object",
      "properties": {
        "waypoints":     { "type": "string" },
        "current_index": { "type": "integer" }
      }
    },
    "Speed": {
      "type": "object",
      "properties": {
        "value": { "type": "number" }
      }
    },
    "GoblinStats": {
      "type": "object",
      "properties": {
        "target_x": { "type": "number" },
        "target_y": { "type": "number" }
      }
    }
  },
  "entityTypes": {
    "Goblin": {
      "behavior": "goblin",
      "requiredComponents": ["Position", "Health", "Sprite"],
      "optionalComponents": ["Path", "Speed", "GoblinStats", "Walking", "Swimming", "Flying", "Phased", "NightVision", "Passability", "Visibility", "OccupiedCells"],
      "allowExtraComponents": false,
      "validationLevel": "strict"
    },
    "Player": {
      "requiredComponents": ["Position", "Health", "Sprite"],
      "optionalComponents": ["Walking", "Swimming", "Flying", "Phased", "NightVision", "Passability", "Visibility", "OccupiedCells"],
      "allowExtraComponents": false,
      "validationLevel": "strict"
    },
    "Tile": {
      "requiredComponents": ["Tile", "TileLayer", "Position", "TileReferences"],
      "optionalComponents": ["Passability", "Visibility", "OccupiedCells"],
      "allowExtraComponents": false,
      "validationLevel": "strict"
    },
    "Floor": {
      "requiredComponents": ["TileVisual", "Passability", "Visibility"],
      "optionalComponents": ["TileEntityOwner", "Position", "OccupiedCells"],
      "allowExtraComponents": false,
      "validationLevel": "strict"
    },
    "Wall": {
      "requiredComponents": ["Passability", "Visibility"],
      "optionalComponents": ["TileVisual", "TileEntityOwner", "Position", "OccupiedCells", "Sprite"],
      "allowExtraComponents": false,
      "validationLevel": "strict"
    },
    "River": {
      "requiredComponents": ["Passability", "Visibility"],
      "optionalComponents": ["TileVisual", "TileEntityOwner", "Position", "OccupiedCells", "Sprite"],
      "allowExtraComponents": false,
      "validationLevel": "strict"
    }
  },
  "interactions": {
    "Passability": {
      "open": { "open": true, "allows": [] },
      "solid": { "open": false, "allows": ["Flying","Phased"] },
      "liquid": { "open": false, "allows": ["Swimming","Flying"] },
      "sealed": { "open": false, "allows": [] }
    },
    "Visibility": {
      "clear": { "open": true, "allows": [] },
      "opaque": { "open": false, "allows": [] },
      "darkness": { "open": false, "allows": ["NightVision"] }
    }
  }
}
