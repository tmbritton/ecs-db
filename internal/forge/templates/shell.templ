package templates

import (
	"strings"

	"github.com/tmbritton/ecs-db/internal/forge/mode"
)

// Shell is the frame every Forge page is delivered in: menu bar across the
// top, mode rail down the left, and the active mode's content filling the
// rest. It knows nothing about what any mode contains — it renders the
// component it is handed.
// Regions is a page's patchable areas, already rendered to HTML.
//
// Already rendered, rather than components to render here, so that a page and
// the SSE stream that follows it go through *one* render path instead of two
// that have to be kept agreeing by hand. The stream skips its first send when
// the page it is attached to already holds these exact bytes, and "these exact
// bytes" is only checkable if both sides produced them the same way.
//
// Each string arrives with its own wrapper element already around it, which is
// why they are emitted here bare. For four of the five that wrapper carries the
// id the stream patches; ModeContent's is the <main> the mode's own regions sit
// inside, and the stream patches those rather than it.
type Regions struct {
	EngineStatus string
	SaveReports  string
	SaveFooter   string
	ModeContent  string
	SaveConfirm  string
}

templ Shell(active mode.Mode, streamQuery string, r Regions) {
	@Layout("Forge — " + active.Title) {
		<div class="shell" data-testid="shell" data-init={ eventStream(active, streamQuery) }>
			@menuBar(r.EngineStatus)
			<div class="shell__body">
				@modeRail(active)
				@templ.Raw(r.ModeContent)
				@templ.Raw(r.SaveFooter)
				@templ.Raw(r.SaveReports)
			</div>
			@templ.Raw(r.SaveConfirm)
		</div>
	}
}

// The menu items open dialogs that arrive in Epic 17. Until then they are
// disabled buttons rather than spans styled to look clickable: a disabled
// button reports its state to a screen reader, and cannot be tabbed to and
// pressed to no effect.
templ menuBar(engineStatus string) {
	<div class="menubar" data-testid="menubar">
		<span class="menubar__wordmark" data-testid="wordmark">⚒ FORGE</span>
		for _, label := range menuLabels {
			<button
				class={ "menu__item", kv("menu__item--accent", label == accentedMenu) }
				type="button"
				disabled
				data-testid={ "menu-item-" + strings.ToLower(label) }
			>{ label }</button>
		}
		<div class="menubar__status">
			@templ.Raw(engineStatus)
		</div>
	</div>
}

templ modeRail(active mode.Mode) {
	<nav class="rail" aria-label="Editor modes" data-testid="mode-rail">
		for _, m := range mode.All {
			<a
				href={ URL(m.Path()) }
				class={ "rail__btn", kv("rail__btn--active", m.Slug == active.Slug) }
				data-testid={ "rail-" + m.Slug }
				data-active={ boolAttr(m.Slug == active.Slug) }
				aria-label={ m.Title }
				if m.Slug == active.Slug {
					aria-current="page"
				}
			>
				<span class="rail__glyph" aria-hidden="true">{ m.Glyph }</span>
				<span class="rail__caption mono" data-testid={ "rail-caption-" + m.Slug }>{ m.Caption }</span>
			</a>
		}
		<button class="rail__btn rail__cog" type="button" disabled title="Preferences" aria-label="Preferences" data-testid="rail-cog">
			<span class="rail__glyph" aria-hidden="true">⚙</span>
		</button>
	</nav>
}

// SaveFooterRegion wraps the footer in the element the SSE stream patches, so
// the region can be re-rendered on its own without touching the rest of the
// shell.
templ SaveFooterRegion(footer Component) {
	<div id="save-footer" class="shell__footer" data-testid="save-footer-slot">
		@footer
	</div>
}


// SaveConfirmRegion is the element the stream patches when a save is held for
// confirmation.
//
// It sits in the shell rather than in a mode because the save footer does: the
// button can be pressed from any of the six modes, and a confirmation that
// only one mode knows how to draw makes the other five answer a save with
// silence. The region is always present so there is something to patch — a
// Datastar patch replaces an element, and an element that is absent until the
// first time it is needed has nothing to replace.
//
// What this region does NOT do is make the rest of the shell inert. `inert`
// would have to sit on .shell__body, which no region patches, so it could only
// ever hold the value it had at page load — and the dialog always arrives
// afterwards, on the stream. Making it work needs the native <dialog> element
// and showModal(), which brings a real focus trap and background inertness
// with it; that is a change to the shared primitive and belongs with Epic 17,
// which builds the rest of the dialog set. Until then the dialog traps clicks
// through its scrim but not the tab order.
templ SaveConfirmRegion(confirm Component) {
	<div id="save-confirm" data-testid="save-confirm-slot">
		if confirm != nil {
			@confirm
		}
	</div>
}

// ModeContentRegion is the <main> a mode's content is delivered in on a page
// load. The stream does not patch it — a mode is patched through its own
// regions, which sit inside this — so it is a wrapper and a layout anchor
// rather than a target.
templ ModeContentRegion(content Component, signals string) {
	<main
		id="mode-content"
		class="shell__content"
		data-testid="mode-content"
		if signals != "" {
			data-signals={ signals }
		}
	>
		@content
	</main>
}
