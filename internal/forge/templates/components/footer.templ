package components

// SaveFooterProps is the sticky save/discard bar shared by SCHEMA, ENTS,
// AGENTS and MAP.
//
// It is deliberately dumb: it takes a dirty flag, the name of the file the
// mode is editing, and two Datastar expressions. It knows nothing about what
// is being saved — that is the caller's business.
type SaveFooterProps struct {
	Dirty         bool
	// Status replaces "saved" on files without a write action (read-only TSJ,
	// unavailable TSX). The footer still reports unsaved work elsewhere.
	Status        string
	// A disappeared file can retain a working copy and offer an explicit way
	// to put it back without mislabelling it "saved".
	StatusAction string
	StatusLabel  string
	File          string // display only, e.g. "overworld.tmx"
	// Title is the hover text for the file label, for a File that summarises
	// several — "3 unsaved machines" says how many and this says which.
	Title string
	SaveAction    string
	DiscardAction string
	// ReloadAction offers an explicit read from disk even when the working file
	// is clean. Currently TILES uses this to pick up edits made in Tiled.
	ReloadAction string
	// Blocked is a save the engine would refuse. Save is disabled and the
	// reason is stated beside it: a control that is disabled for a reason the
	// user cannot see is indistinguishable from one that is broken, and the
	// point of validating while editing is to say so before the button is
	// pressed rather than after.
	//
	// Discard stays enabled. It is the way out of an invalid state, and taking
	// it away leaves someone stuck with a file they cannot save and cannot
	// abandon.
	Blocked bool
	// Elsewhere names unsaved work this footer cannot save, because one Save
	// button does one thing and the footer follows the mode. Without it,
	// switching modes reads as "everything is saved".
	Elsewhere string
	// BlockedReason is the one-line summary shown beside the disabled button.
	// The problems themselves render inline, against what caused them.
	BlockedReason string
}

templ SaveFooter(props SaveFooterProps) {
	<div
		class={ classes("save-footer", when(props.Dirty, "save-footer--dirty"), when(props.Blocked, "save-footer--blocked")) }
		data-testid="save-footer"
		data-blocked={ boolAttr(props.Blocked) }
	>
		<div class="save-footer__hint mono">
			if props.Status != "" {
				{ props.Status }
			} else if props.Dirty {
				● unsaved
			} else if props.Elsewhere != "" {
				● saved here
			} else {
				✓ saved
			}
			if props.File != "" {
				<span
					class="save-footer__file"
					data-testid="save-footer-file"
					if props.Title != "" {
						title={ props.Title }
					}
				>· { props.File }</span>
			}
			if props.Elsewhere != "" {
				<span class="save-footer__elsewhere" data-testid="save-elsewhere">· { props.Elsewhere }</span>
			}
			if props.Blocked && props.BlockedReason != "" {
				<span class="save-footer__blocked" data-testid="save-blocked">· { props.BlockedReason }</span>
			}
		</div>
		if props.StatusAction != "" {
			<div class="save-footer__actions">
				<button type="button" class="save-footer__save" data-testid="save-footer-restore" data-on:click={ props.StatusAction }>{ props.StatusLabel }</button>
				if props.ReloadAction != "" {
					<button type="button" class="save-footer__discard" data-testid="save-footer-reload" data-on:click={ props.ReloadAction }>Reload from disk</button>
				}
			</div>
		} else if props.Status != "" && props.ReloadAction != "" {
			<div class="save-footer__actions">
				<button type="button" class="save-footer__discard" data-testid="save-footer-reload" data-on:click={ props.ReloadAction }>Reload from disk</button>
			</div>
		} else if props.Status == "" {
		<div class="save-footer__actions">
			if props.ReloadAction != "" {
				<button type="button" class="save-footer__discard" data-testid="save-footer-reload" data-on:click={ props.ReloadAction }>Reload from disk</button>
			}
			<button
				type="button"
				class="save-footer__discard"
				disabled?={ !props.Dirty }
				if props.Dirty && props.DiscardAction != "" {
					data-on:click={ props.DiscardAction }
				}
			>Discard</button>
			<button
				type="button"
				class="save-footer__save"
				disabled?={ !props.Dirty || props.Blocked }
				if props.Blocked {
					title={ props.BlockedReason }
				}
				if props.Dirty && !props.Blocked && props.SaveAction != "" {
					data-on:click={ props.SaveAction }
				}
			>Save</button>
		</div>
		}
	</div>
}
